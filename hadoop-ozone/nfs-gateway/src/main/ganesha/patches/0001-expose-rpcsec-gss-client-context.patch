+	op_ctx->client_rpcsec_gss_service = 0;
+	op_ctx->client_rpcsec_gss_mech_len = 0;
+	memset(op_ctx->client_rpcsec_gss_mech, 0,
+	       sizeof(op_ctx->client_rpcsec_gss_mech));
+	op_ctx->client_rpcsec_gss_principal_len = 0;
+	memset(op_ctx->client_rpcsec_gss_principal, 0,
+	       sizeof(op_ctx->client_rpcsec_gss_principal));
 
 	switch (req->rq_msg.cb_cred.oa_flavor) {
 	case AUTH_NONE:
@@ -304,10 +312,38 @@ nfsstat4 nfs_req_creds(struct svc_req *req)
 
