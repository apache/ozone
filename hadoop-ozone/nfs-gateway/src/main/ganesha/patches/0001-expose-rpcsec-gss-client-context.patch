 	case RPCSEC_GSS:
+		gd = SVCAUTH_PRIVATE(req->rq_auth);
+		if (gd == NULL || gd->cname.value == NULL || gd->cname.length == 0 ||
+		    gd->cname.length > sizeof(op_ctx->client_rpcsec_gss_principal) ||
+		    gd->sec.mech == NULL || gd->sec.mech->elements == NULL ||
