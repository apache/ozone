diff --git a/src/support/nfs_creds.c b/src/support/nfs_creds.c
index 22ff12d..a2a6e33 100644
--- a/src/support/nfs_creds.c
+++ b/src/support/nfs_creds.c
@@ -254,6 +254,56 @@ int nfs_rpc_req2client_cred(struct svc_req *req, nfs_client_cred_t *pcred)
  * @return NFS4_OK if successful, NFS4ERR_ACCESS otherwise.
  *
  */
+nfsstat4 nfs_capture_rpcsec_gss_context(struct svc_req *req)
+{
+#ifdef _HAVE_GSSAPI
+	struct svc_rpc_gss_data *gd;
+
+	if (op_ctx == NULL)
+		return NFS4ERR_ACCESS;
+	op_ctx->client_auth_flavor = req->rq_msg.cb_cred.oa_flavor;
+	op_ctx->client_rpcsec_gss_service = 0;
+	op_ctx->client_rpcsec_gss_mech_len = 0;
+	memset(op_ctx->client_rpcsec_gss_mech, 0,
+	       sizeof(op_ctx->client_rpcsec_gss_mech));
+	op_ctx->client_rpcsec_gss_principal_len = 0;
+	memset(op_ctx->client_rpcsec_gss_principal, 0,
+	       sizeof(op_ctx->client_rpcsec_gss_principal));
+	if (req->rq_msg.cb_cred.oa_flavor != RPCSEC_GSS)
+		return NFS4_OK;
+	gd = SVCAUTH_PRIVATE(req->rq_auth);
+	if (gd == NULL || gd->cname.value == NULL || gd->cname.length == 0 ||
+	    gd->cname.length > sizeof(op_ctx->client_rpcsec_gss_principal) ||
+	    gd->sec.mech == NULL || gd->sec.mech->elements == NULL ||
+	    gd->sec.mech->length == 0 ||
+	    gd->sec.mech->length > sizeof(op_ctx->client_rpcsec_gss_mech))
+		return NFS4ERR_ACCESS;
+	op_ctx->client_rpcsec_gss_mech_len = gd->sec.mech->length;
+	memcpy(op_ctx->client_rpcsec_gss_mech, gd->sec.mech->elements,
+	       gd->sec.mech->length);
+	switch (gd->sec.svc) {
+	case RPCSEC_GSS_SVC_INTEGRITY:
+		op_ctx->client_rpcsec_gss_service =
+			FSAL_RPCSEC_GSS_PROTECTION_INTEGRITY;
+		break;
+	case RPCSEC_GSS_SVC_PRIVACY:
+		op_ctx->client_rpcsec_gss_service =
+			FSAL_RPCSEC_GSS_PROTECTION_PRIVACY;
+		break;
+	case RPCSEC_GSS_SVC_NONE:
+		op_ctx->client_rpcsec_gss_service =
+			FSAL_RPCSEC_GSS_PROTECTION_NONE;
+		break;
+	default:
+		return NFS4ERR_ACCESS;
+	}
+	op_ctx->client_rpcsec_gss_principal_len = gd->cname.length;
+	memcpy(op_ctx->client_rpcsec_gss_principal, gd->cname.value,
+	       gd->cname.length);
+#endif
+	return NFS4_OK;
+}
+
 nfsstat4 nfs_req_creds(struct svc_req *req)
 {
 	unsigned int i;
